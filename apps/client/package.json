{
  "name": "@zeta/client",
  "version": "0.1.0",
  "description": "Cliente React com Vite, TanStack Router/Query, Tailwind e shadcn/ui.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run typecheck && bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "start": "bun server/main.ts",

    "typecheck": "bun run routes:generate && bun run --bun tsc --noEmit && bun run --bun tsc --noEmit -p tsconfig.server.json",
    "test": "bun test tests",

    "routes:generate": "bun run --bun tsr generate"
  },
  "dependencies": {
    "@orpc/client": "1.15.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@zeta/access": "workspace:*",
    "@zeta/guide-content": "workspace:*",
    "@zeta/server": "workspace:*",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.33",
    "@tanstack/router-plugin": "1.168.35",
    "@types/bun": "1.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
